# ── Evolution API (WhatsApp) ─────────────────────────────────────
# Dua nilai ini diisi otomatis oleh setup.sh kalau masih kosong.
EVOLUTION_API_KEY=
POSTGRES_PASSWORD=
# Port Evolution di host. Cuma di-bind ke 127.0.0.1 (akses luar lewat SSH tunnel).
EVOLUTION_PORT=8085
EVOLUTION_URL=http://localhost:8085
# Nama instance WhatsApp di Evolution
INSTANCE=recap
# Container Postgres yang di-query script (sesuai docker-compose.yml)
PG_CONTAINER=wa-recap-postgres
PG_USER=evolution
PG_DB=evolution

# ── Rekap ────────────────────────────────────────────────────────
# Zona waktu batas hari rekap (00:00-24:00). Samakan dengan timezone server.
TZ_NAME=Asia/Jakarta
# Jadwal cron rekap harian (jam server)
EXPORT_CRON=0 5 * * *
# Nomor WA penerima rekap, format 62xxx atau 08xxx, pisahkan koma
RECIPIENTS=
# per_group = ringkasan + 1 pesan per grup, combined = semua digabung 1 pesan
SUMMARY_MODE=per_group
# true = file txt mentah ikut dikirim. Kalau summary gagal, txt selalu dikirim.
SEND_TXT=false
# Pesan grup target disimpan di DB sekian hari (buat export ulang)
DB_RETENTION_DAYS=7
# File txt di output/ disimpan sekian hari
TXT_RETENTION_DAYS=30

# ── Web summary (lihat docs/WEB_API.md) ──────────────────────────
# Kosongkan untuk melewati tahap summary (txt langsung dikirim ke WA)
RECAP_API_URL=
# multipart = upload file txt, json = isi txt dikirim di body JSON
RECAP_API_MODE=multipart
RECAP_API_FILE_FIELD=file
RECAP_API_TEXT_FIELD=text
# Kosongkan RECAP_API_PASSWORD_FIELD kalau web gak punya field password
RECAP_API_PASSWORD_FIELD=password
RECAP_API_PASSWORD=
# Letak teks summary di respons JSON (dot path, mis. data.summary).
# Respons text/plain dipakai apa adanya.
RECAP_API_RESULT_PATH=summary
RECAP_API_TIMEOUT=180
# Header x-vercel-protection-bypass kalau web di Vercel pakai Deployment Protection
VERCEL_PROTECTION_BYPASS=
# Opsional: dikirim sebagai "Authorization: Bearer <token>"
RECAP_API_TOKEN=
